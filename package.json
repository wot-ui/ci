{
  "name": "@wot-ui/ci",
  "type": "module",
  "version": "0.5.2",
  "packageManager": "pnpm@10.25.0",
  "description": "小程序多平台 CI 上传工具，支持 JS API、JS/TS 配置文件与环境变量注入",
  "author": "weisheng",
  "license": "MIT",
  "homepage": "https://github.com/wot-ui/ci#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wot-ui/ci.git"
  },
  "bugs": "https://github.com/wot-ui/ci/issues",
  "keywords": [
    "uni-app",
    "mini-program",
    "wechat",
    "alipay",
    "dingtalk",
    "ci"
  ],
  "sideEffects": false,
  "exports": {
    ".": "./dist/index.mjs",
    "./bin": "./dist/bin.mjs",
    "./cli": "./dist/cli.mjs",
    "./vite": "./dist/vite.mjs",
    "./package.json": "./package.json"
  },
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "bin": {
    "wotci": "./dist/bin.mjs"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "lint": "eslint",
    "prepublishOnly": "pnpm run build",
    "release": "bumpp",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:exports": "vitest run test/exports.test.ts",
    "verify:capabilities": "node scripts/verify-capabilities.mjs",
    "verify:action": "node scripts/verify-action-metadata.mjs",
    "verify:release": "node scripts/verify-release.mjs",
    "verify:marketplace": "node scripts/verify-marketplace-listing.mjs",
    "typecheck": "tsc",
    "typecheck:all": "pnpm typecheck && pnpm typecheck:playground",
    "site:dev": "pnpm --dir apps/website dev",
    "site:build": "pnpm --dir apps/website build",
    "site:test": "pnpm --dir apps/website test",
    "site:test:build": "pnpm --dir apps/website test:build",
    "site:typecheck": "pnpm --dir apps/website typecheck",
    "site:preview": "pnpm --dir apps/website preview",
    "prepare": "simple-git-hooks",
    "build:playground": "pnpm --dir playground build:h5",
    "dev:playground": "pnpm --dir playground dev:h5",
    "typecheck:playground": "pnpm --dir playground type-check",
    "upload:playground:weixin": "pnpm --dir playground build:mp-weixin && pnpm exec tsx ./src/bin.ts --cwd playground --config wotci.config.ts --platform weixin",
    "upload:playground:alipay": "pnpm --dir playground build:mp-alipay && pnpm exec tsx ./src/bin.ts --cwd playground --config wotci.config.ts --platform alipay",
    "upload:playground:dingtalk": "pnpm --dir playground build:mp-alipay && pnpm exec tsx ./src/bin.ts --cwd playground --config wotci.config.ts --platform dingtalk"
  },
  "peerDependencies": {
    "vite": ">=5"
  },
  "peerDependenciesMeta": {
    "vite": {
      "optional": true
    }
  },
  "dependencies": {
    "consola": "catalog:",
    "dingtalk-miniapp-opensdk": "catalog:",
    "json5": "catalog:",
    "minidev": "catalog:",
    "miniprogram-ci": "catalog:",
    "tsx": "catalog:cli"
  },
  "devDependencies": {
    "@antfu/eslint-config": "catalog:cli",
    "@antfu/ni": "catalog:cli",
    "@antfu/utils": "catalog:inlined",
    "@types/node": "catalog:types",
    "@vitest/coverage-v8": "catalog:testing",
    "bumpp": "catalog:cli",
    "eslint": "catalog:cli",
    "lint-staged": "catalog:cli",
    "publint": "catalog:cli",
    "simple-git-hooks": "catalog:cli",
    "tinyexec": "catalog:testing",
    "tsdown": "catalog:cli",
    "typescript": "catalog:cli",
    "vite": "catalog:cli",
    "vitest": "catalog:testing",
    "vitest-package-exports": "catalog:testing",
    "yaml": "catalog:testing"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm i --frozen-lockfile --ignore-scripts --offline && npx lint-staged"
  },
  "lint-staged": {
    "*": "eslint --fix"
  }
}
