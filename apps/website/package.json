{
  "name": "@wot-ui/ci-website",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev --webpack --hostname 127.0.0.1 --port 4173",
    "build": "pnpm build:next",
    "build:next": "next build --webpack && node scripts/cleanup-next-output.mjs",
    "start": "next start --hostname 127.0.0.1 --port 4173",
    "test": "node --test test/*.test.mjs",
    "test:build": "node scripts/verify-next-build.mjs",
    "typecheck": "tsc --noEmit",
    "preview": "pnpm start"
  },
  "dependencies": {
    "marked": "catalog:website",
    "next": "catalog:website",
    "react": "catalog:website",
    "react-dom": "catalog:website"
  },
  "devDependencies": {
    "@types/node": "catalog:types",
    "@types/react": "catalog:website",
    "@types/react-dom": "catalog:website",
    "typescript": "catalog:cli"
  }
}
